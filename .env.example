# Template only — copy to `.env` and keep that file local (gitignored).
# Never put live Razorpay / PetPooja / WhatsApp keys in this file.

DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_orders?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Auth — required in all environments (fail loud if missing)
STAFF_SESSION_SECRET=change-me-to-a-long-random-string

# Local fake Razorpay mock-confirm (never set to 1 in production)
ALLOW_FAKE_PAYMENTS=1

# Behind Caddy/nginx leave on (default). Set 0 only if the API is exposed directly.
TRUST_PROXY=1

# Adapter modes: fake | live
PETPOOJA_ADAPTER=fake
PAYMENT_ADAPTER=fake
NOTIFICATION_ADAPTER=fake

# Razorpay (required when PAYMENT_ADAPTER=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional until Dashboard webhook is configured (Checkout confirm works without it)
RAZORPAY_WEBHOOK_SECRET=
# Shown on Checkout.js modal (defaults to Chote Bade Café)
RAZORPAY_CHECKOUT_NAME=Chote Bade Café
# Optional Checkout branding
# RAZORPAY_CHECKOUT_LOGO=https://example.com/logo.png
# RAZORPAY_CHECKOUT_THEME_COLOR=#7A1F2B

# Customer Vite app (KEY_ID only — never put KEY_SECRET in frontend env):
#   apps/customer-app/.env → VITE_RAZORPAY_KEY_ID=rzp_test_…

# PetPooja Online Ordering API (support@petpooja.com for keys)
# Keep PETPOOJA_ADAPTER=fake until credentials + PUBLIC_API_URL are set, then flip to live.
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=
# Required for inbound webhooks (HMAC, Bearer, or x-api-key)
PETPOOJA_WEBHOOK_SECRET=dev-petpooja-webhook-secret
PETPOOJA_FORCE_FAIL=
# Public API origin (no trailing slash) — used as save_order callback_url base
# PUBLIC_API_URL=https://api.example.com
# Or set the full status callback URL explicitly:
# PETPOOJA_CALLBACK_URL=https://api.example.com/petpooja/webhooks/order-status
# Tell PetPooja support to POST Push Menu to:
#   {PUBLIC_API_URL}/petpooja/webhooks/push-menu
# with Authorization: Bearer <PETPOOJA_WEBHOOK_SECRET>

# QR table allowlist (comma-separated). Empty = accept any (dev only).
# TABLE_IDS=T1,T2,T3,1,2,3

# Memory Wall photo uploads (defaults to ./uploads/memory)
# MEMORY_UPLOAD_DIR=

# WhatsApp BSP + SMS fallback (required when NOTIFICATION_ADAPTER=live)
WHATSAPP_BSP_PROVIDER=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_API_URL=
SMS_FALLBACK_PROVIDER=
SMS_FALLBACK_API_KEY=
SMS_FALLBACK_API_URL=
# Never set until live notifier is implemented
# NOTIFICATION_LIVE_OK=1
