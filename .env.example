# Template only — copy to `.env` and keep that file local (gitignored).
# Never put live Razorpay / PetPooja / WhatsApp keys in this file.

DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_orders?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Auth — required in all environments (fail loud if missing)
STAFF_SESSION_SECRET=change-me-to-a-long-random-string

# Local fake Razorpay mock-confirm (never set to 1 in production)
ALLOW_FAKE_PAYMENTS=1

# Behind Caddy/nginx leave on (default). Set 0 only if the API is exposed directly.
TRUST_PROXY=1

# Adapter modes: fake | live
PETPOOJA_ADAPTER=fake
PAYMENT_ADAPTER=fake
NOTIFICATION_ADAPTER=fake

# Razorpay (required when PAYMENT_ADAPTER=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PetPooja — webhook secret required even in fake mode
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=
PETPOOJA_WEBHOOK_SECRET=dev-petpooja-webhook-secret
PETPOOJA_FORCE_FAIL=

# WhatsApp BSP + SMS fallback (required when NOTIFICATION_ADAPTER=live)
WHATSAPP_BSP_PROVIDER=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_API_URL=
SMS_FALLBACK_PROVIDER=
SMS_FALLBACK_API_KEY=
SMS_FALLBACK_API_URL=
