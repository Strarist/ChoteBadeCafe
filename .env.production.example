# Copy to .env.production and fill in real values.
#   cp .env.production.example .env.production
# Do not commit .env.production.

# Public site Caddy will serve. Use your domain for HTTPS, or `:80` for LAN/HTTP-only.
SITE_ADDRESS=orders.example.com
CADDY_EMAIL=you@example.com

# Compose interpolates these for Postgres/Redis. Use long random values.
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-long-random-password

# API — same-origin via Caddy, so CORS is just the public origin.
PORT=3001
CORS_ORIGINS=https://orders.example.com
STAFF_SESSION_SECRET=replace-with-at-least-32-random-chars

# Leave unset / 0 in production. Mock confirm is refused when NODE_ENV=production.
ALLOW_FAKE_PAYMENTS=0

# First boot used to gate seeding. Entrypoint now always runs idempotent seed.
# Kept for docs/compat; unused by deploy/api-entrypoint.sh.
SEED_ON_BOOT=0

# Adapters: fake | live
# Counter-only launch can stay on fake payment if customers only pay at the till.
PETPOOJA_ADAPTER=fake
PAYMENT_ADAPTER=fake
NOTIFICATION_ADAPTER=fake

# Required when PAYMENT_ADAPTER=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_NAME=Chote Bade Café
# RAZORPAY_CHECKOUT_LOGO=https://chotebadecafe.com/logo.png
# RAZORPAY_CHECKOUT_THEME_COLOR=#7A1F2B

# PetPooja — webhook secret required even in fake mode
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=
PETPOOJA_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Required when NOTIFICATION_ADAPTER=live
WHATSAPP_BSP_PROVIDER=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_API_URL=
SMS_FALLBACK_PROVIDER=
SMS_FALLBACK_API_KEY=
SMS_FALLBACK_API_URL=
